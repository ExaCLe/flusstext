{
  "name": "FlusstextNative",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start --port 8097",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:core": "node --test tests/*.test.cjs",
    "macos": "react-native run-macos",
    "engine:mac": "node scripts/build-whisper-mac.cjs && node scripts/build-mac-engine.cjs",
    "bundle:mac": "FLUSSTEXT_PLATFORM=macos react-native bundle --platform macos --dev false --entry-file index.js --bundle-output dist/main.jsbundle --assets-dest dist",
    "postinstall": "node scripts/patch-native.cjs"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "2.36.0",
    "@kesha-antonov/react-native-background-downloader": "^4.5.4",
    "buffer": "^6.0.3",
    "docx": "^9.13.0",
    "lucide-react-native": "^1.16.0",
    "onnxruntime-react-native": "1.23.2",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-macos": "0.83.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-sherpa-onnx": "0.4.4",
    "react-native-svg": "15.15.0",
    "whisper.rn": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
