{
  "name": "flusstext",
  "productName": "Flusstext",
  "version": "0.1.2",
  "description": "Lokale Transkription & Diktat mit Open-Source-Modellen",
  "main": "./out/main/index.js",
  "author": "ExaCLe",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:downloads": "electron scripts/test-downloads.cjs",
    "test:nemotron": "node --test scripts/test-nemotron.cjs",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "docx": "^9.13.0",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-web": "1.22.0",
    "sherpa-onnx-node": "^1.13.8",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "zustand": "^5.0.15"
  }
